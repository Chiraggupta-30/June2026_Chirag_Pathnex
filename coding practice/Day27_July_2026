# to install apache on Linux

---
- name: Install and Start The Apache
  hosts: Webserver
  become: yes

  tasks:

    - name: Installing Apache
      dnf:
        name: httpd
        state: present

    - name: Enabling the Apache service
      service:
        name: httpd
        state: started
        enabled: yes


# install nginx on ubuntu 

---
- name: Installing and starting Apache on Ubuntu
  hosts: frontend_build
  become: yes

  tasks:

    - name: Installing Apache
      apt:
        name: apache2
        state: present
        update_cache: yes

    - name: Enabling Apache service
      service:
        name: apache2
        state: started
        enabled: yes


