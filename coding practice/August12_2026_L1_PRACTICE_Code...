-# FOr kubernerets with resource and limit 

apiVersion: v1
kind: Pod 
metadata: 
 name: order-pod 

spec: 
  containers: 
   - name: order
     image: order:latest 
    
     resources:
      requests:                  # minimum resource the pod will get  
       cpu: "100m" 
       memory: "128Mi"
 
      limits:                    # maxmimum resource the pod can use 
       cpu: "500m"
       memory: "512Mi"



