-# Anisble For restarting the Nginx 

---
- name: Copy and Star the nginx 
  hosts: ubuntu
  bceome: yes 

  tasks: 
   - name: Copy the file onto the server....
     copy: 
      src: index.html
      dest: /usr/share/nginx/html/index.html 
      notify: restart nginx

  handlers: 
   - name: restart nginx
     service: 
      name: nginx
      state: restarted 

-# terraform for ec-2 and insatlling nginx c6a.12xlarge

provider "aws" {
  region = "ap-south-1"
  }

resource "aws_instsnce" "bakend_server" {
  
   ami                     =  "ami-241122"
   subnet_id               =  "subnet-727"
   region                  =  "ap-south-1" 
   key_name                =   "backend_server"
   vpc_security_group_ids  =   ["sg-2282"]

   user_data = >> EOF         # user data shared the data or script to aws after creating ec2 instance so that i can be executed on it"  and you can use any name i use EOF because it's widely used i can use Script/run or any other name
   #!/bin/bash  
   yum install -y nginx 
   systemctl start nginx
   EOF 


