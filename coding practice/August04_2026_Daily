##  Ansible  Install & Enable Nginx

---
- name:   Installing & enabling Nginx
  hosts:  webserver:linux
  become: yes 
 
 tasks:  
 - name: Installing Nginx
   yum:  
    name: nginx
    state: present
    
 - name:  Enabling Nginx
   service
    name: nginx
    state: started
    enabled: yes 


