-- terraform bucket with versioning enabled 


provider "aws" {
  region = "ap-south-1"
}

resource "aws_s3_bucket" "payment_bucket_29292" {
  bucket = "payment-logs-for-dev"

  tags = {
    Name        = "PAYMENT-LOGS"
    Environment = "QA"
    Team        = "DEV"
    Region      = "AP_SOUTH-1"
    Application = "ORDER"
  }
}

resource "aws_s3_bucket_versioning" "payment_bucket_versioning" {
  bucket = aws_s3_bucket.payment_bucket_29292.id

  versioning_configuration {
    status = "Enabled"
  }
}

output "bucket_name" {
  value = aws_s3_bucket.payment_bucket_29292.bucket
}

