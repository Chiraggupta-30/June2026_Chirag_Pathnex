FROM maven:3.9.9-eclipse-temurin-21-jdk AS builder
WORKDIR /order
COPY . .
RUN mvn clean package -DskipTests


FROM eclipse-temurin:21-jre-alpine 
WORKDIR /order
COPY --from=builder /order/target/*.jar orders.jar
EXPOSE 8080
CMD ["java", "-jar", "orders.jar"]



---- for python


FROM python:3.12-slim
WORKDIR /app
COPY . .
RUN pip install -r requirements.txt 
EXPOSE 8000
CMD ["python", "backend.py"]


---- for node 

FROM node:22-alpine
WORKDIR /app
COPY . .
RUN npm install
EXPOSE 3000
CMD ["npm", "start"]


