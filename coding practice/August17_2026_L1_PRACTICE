pipeline { 
 agent  {
   label 'ubuntu'
  }

stages{
  
stage('checkout') {
  steps{ 
     echo "Checking Out The Code From GitHub"
      git branch: 'Main',
             url: 'https://github.com/payment-service.git'
    }
  }

stage('build'){ 
  steps{  
    echo "starting the building phase...."
     sh 'mnv clean build -DskipTests'
    }
  }

stage('Unit Testing') {
   steps{
