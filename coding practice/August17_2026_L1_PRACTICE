      sh 'mvn test'
    }
 }

stage('Docker Image') {
   steps{ 
      echo "Test Successfull, building the docker image"  
      sh 'docker build -t "
   }
}

stage('Pushing To ECR') {
  steps{ 
    echo "docker image being uploaded to ecr.."
      sh 'docker push'
   }
 
stage('Deployment'){
  steps{
    echo "Image is being Deployed"
