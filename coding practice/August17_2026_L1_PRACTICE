provider "aws" {
  region = "ap-south-1" 
 }

resource "aws_instance" "frontend_server" {
  instane_type                  =  "c7i-flex.large"
  ami                           =  "ami-62527"
  subnet_id                     =  "subnet-7272"
  key                           =  "front-end-access"
  vpc_security_group_ids        =  ["sg-827272"]

  tags = {
   
  NAME          =    "front-end-server"
  ENVIRONMENT   =    "DEV"
  REGION        =    "AP-SOUTH-1"
  APPLICATION   =    "PAYMENT"
  TEAM          =    "DEV-TEAM-BAT"
    }
  }

output "PUBLIC_IP" {
  value =  aws_instance.[*].frontend_server.public_ip
 }

output "PRIVATE_IP"  {
  value =  aws_instance.frontend_server.private_ip
  }

output "Instance_Type" {
  value = aws_instance.frontend_server.instance_type
}
 

