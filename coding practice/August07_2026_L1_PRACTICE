Docker 
FROM python:3.12-slim
WORKDIR /workspace
COPY . .
 RUN pip install -r requirements.txt
 EXPOSE 8000
CMD [“python”, “payment.py”]
FROM node:22-apline
WORKDIR /payment
COPY . .
RUN npm install
EXPOSE 3000
 CMD [“npm”, “start”]

