FROM maven:3.9.9-eclipse-temurin-21-jdk AS builder
 WORKDIR /payment
 COPY . .
 RUN mvn clean package -DskipTests
FROM eclipse-temurin-19-jre-alpine
 WORKDIR /payment
COPY -from=builder /payment/target/*.jar order.jar
 EXPOSE 8080
CMD [“-jar”, “java”, “order.jar”]

