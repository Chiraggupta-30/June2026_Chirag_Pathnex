—- Ansible playbook

 —
 - name: Install & Enable Nginx
    hosts:  linux:ubuntu:frontend
    become: yes

    tasks: 
   - name: Installing Nginx
       yum: 
        name: nginx
         state:  present
          
   - name: enabling the nginx
       service: 
         name: nginx
          state:  present
          enable:  yes     #starts the service when server get started


