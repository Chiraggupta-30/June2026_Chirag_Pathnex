 Kubernetes Yaml file




For replicaset

 apiVersion: apps/v1
 kind:            ReplicaSet
 metadata:   
    name: alert-service-replicaset


spec:
  replicas: 5
  selector:
     matchLabels:
      app: alert
 
  template:
    metadata:
      labels:
         app: alert
  
    Spec: 
      Containers: 
        - name: alert-pod
           Image: alert-service:latest
           Ports:
            - containerPort: 80

 For pods

 apiVersion: v1
Kind:        Pod
Metadata: 
    Name:   backend-pod


Spec: 
     Containers: 
      - name: backend 
         Image: backend:latest          
         ports: 
          - containerPort: 80 
 
 for StatefulSet

 apiVersion: apps/v1
 kind:         StatefulSet
 metadata: 
    Name: backend-database-replicaset

 spec:
   serviceName:  “database” #headless_service
   replicas:     5
   selector: 
      matchLabels: 
          app: backend
  
    template: 
      metadata: 
         labels: 
           app: backend 
   
       Spec: 
          Containers: 
           - name: Backend-pod
              Image: database:latest
               ports:
              - containerPort: 80
 

