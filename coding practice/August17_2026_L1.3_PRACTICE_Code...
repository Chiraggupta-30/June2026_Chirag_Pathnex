apiVersion: v1
kind: Pod
metadata: 
  name: Backend-livenedd-readiness-pod

spec:

containers:
 - name: backend 
   image: backend:latest 
   livenessProbe:
     httpGet: 
      path: /
      port: 80
     initialDelaySeconds: 5
   
    readinessProbe:
      httpGet:
        path: /
        port: 80
      initialDelaySeconds: 3

