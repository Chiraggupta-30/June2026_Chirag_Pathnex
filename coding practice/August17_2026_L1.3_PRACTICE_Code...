# terraform VPC + SUBNET 

provider "aws" {
  region = "ap-south-1" 
}

resource "aws_vpc" "hcl_vpc" {
 cidr_block  = "10.0.0.0/16"
 
 tags  = {

 NAME   = "HCL_VPC" 
    }
  }


resource "aws_subnet" "subnet_hcl" {
   vpc_id                   =  "aws_vpc.hcl_vpc.id"
  cidr_block                =  "10.0.10.0/24"
 maps_public_ip_on_launch   = true 

tags = { 
  
 NAME = "HCL-Subnet" 
  
   }
}

