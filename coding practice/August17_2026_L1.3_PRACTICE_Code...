# Conditional Stages

## 🔹 Jenkins Pipeline — Conditional Execution

pipelien {
  agent any 
 
 parameter {
   string{name: 'ENVIRONMENT', defaultValue: 'DEV', description: 'ENVIRONMENT FOR DEPLOYMENT'}
 }

environment {
   COMPANY_NAME: "AMERICAN-EXPRESS"
}

stages {
  
  stage('Checkout') {
      steps { 
           git branch: 'Main',
                  Url: https://github.com/payment-java.git
        }
     }

   stage('Build') {
            when { 
                branch 'Main'
              }
      steps {
       sh ' echo "Bulding the application for $COMPANY_NAME"'
         sh 'mvn clean package -DskipTests'
        }
      }   
    
    stage('Deploy') { 
        when { 
           expression { params.ENVIRONMENT == 'UAT' } 
          } 
       steps {
         sh 'echo "Deploying Application in $ENVIRONMENT by $COMPANY_NAME"'
         sh 'kubectl apply -f deployment.yaml'
        }
      }
    }
 }

