#for Ansible

---
- name: Installing All The Required Package 
  hosts: all
  become: yes 
  
  vars: 
    packages: 
     - tee
     - uzip
     - gzip
     - vim

  task: 
   - name: Install All The Required Packaeges"
      yum: 
       name: "{{ packages }}"
       state: present 

