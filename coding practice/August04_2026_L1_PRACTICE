  steps{ 
         git branch: 'Main',
               url:   'https://github.com/dev-appliction.git'
     }
  }

stage('Build') {
 steps { 
     echo " Building The Java Application" 
     sh 'mvn clean package -Dskiptests'
  }
}

stage('Unit test'){
   steps{ 
       echo 'Starting The Unit Test'
        sh 'mvn test'
   }
 }

stage('Docker Image'){
       steps{ 
          echo 'Building the docker image'
           sh 'docker build -t java-frontend:latest .'
    }
  }

stage('DOcker Hub'){
    steps{ 
       echo 'Pushing The Image To Docker'   
       sh 'docker push'
    }
  }

stage(Deployment){
      steps{   
          echo 'Deploying The App to Kubernetes'
            sh 'Kubectl apply -f deployment.yaml'
         }
       }
     }
   }

