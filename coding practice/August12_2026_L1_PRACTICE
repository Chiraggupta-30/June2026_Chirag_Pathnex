RUN mvn package clean -DsktipTest



FROM eclipse-temurin-21-jre 
WORKDIR /inventory 
COPY from=builder /inventory/target/*.jar backend-payment.jar
EXPOSE 8080
CMD ["java", "-jar", "backend-payment.jar"]




