# 🔹 GitLab CI — Fixed 

stages: 
  - buiild
  - test 
   
build_job: 
  stage: build
  image: maven:3.9.9-jdk-21
  script: 
   - git clone https://github.com/Pathnex/sample-java-app.git
   - cd sample-java-app
   - mvn clean compile || { echo "Compile failed"; exit 1;  }
   artifacts:
    path: 
      - sample-java-app/

test_job:
   stage: test
   image: maven:3.9.9-jdk-21
   dependencies: 
    - build 
   script: 
    - cd sample-java-app
    - mvn test || { echo "Test failed during the process"; exit 1; }
    

