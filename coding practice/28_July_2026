# terraform code for S3 bucket

provider "aws" {
   region = "ap-south-1" {

resource "aws_s3_bucket" "logs_file" {
    bucket    =      "payment-log-file-QA-2829"
    
  
tags = { 
  
  Region         =   "ap-south-1" 
  Application    =   "QA"
  Team           =   "Devops" 
  Name           =   "logs-file"
  
     } 
   }
 }

output "bucket_name" {
  value = "aws_s3_bucket.logs_file.bucket"
}



## for Ec2 

provider "aws" {
 region = "ap-south-1" {
 
resource "aws_instance" "database_server"  {
  
  ami                     =        "ami-232221"
  instance_type           =        "c7i-flex.large"
  key_name                =        "ssh-unlock"
  subnet_id               =        "subnet-211"
  vpc_security_group_ids  =        ["sg-31221"]


tags = {
  
  NAME           =  "webserver-for-database"
  ENVIRONMENT    =   "DEV"
  APPLICATION    =   "Database"
  TEAM           =    "Devops"

    } 
   }
  }

output "Public_IP"  {
  value     =   "aws_instance.database_server.[*].Public_IP"
}

output "Private_IP"
   value    =  "aws_instanece.database_server.[*].Private_IP"     #only use [*] when there is more then 1 ec2 instance 

}

