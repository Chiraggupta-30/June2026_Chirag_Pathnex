# kubernets Yaml for pods (declrative one)


apiVersion: v1
kind:   Pod
metadata: 
 name: Payment-Pod
spec:
  containers:
    - name: Payment
      image: Payment:latest 
      ports: 
       - containerPort: 80


## For service

apiVersion: v1
kind:   Service
metadata: 
  name:  Backend-service
spec:
  selector:
    app: Backend

  ports:
    - protocol: TCP 
      port:   80
      targetPort:   80
  
  type: LoadBalancer


