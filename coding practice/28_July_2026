#multi stage docker hub

FROM maven:3.9.9-eclipse-temurin  AS builder
WORKDIR /workspace
COPY . . 
RUN mvn clean package -DskipTests


FROM eclipse-temurin-17-jre-alpine
WORKDIR /workspace
COPY -from=builder /workspace/target/*.jar frontend.jar
EXPOSE 7554                                  # Usually it goes exposed on port number 8080 default port of java but totally depends on the requirements which is in the file 
CMD ["java", "-jar", "payment.jar"]


