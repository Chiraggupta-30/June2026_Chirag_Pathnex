# ansible  for installing nginx

---
- name: Installing Nginx and Start the Service
  hosts: Linux:Ubuntu
  become: yes

  tasks:
   
    -name: Installing nginx
     yum: 
       name: nginx
       state: present
  
    -name: Starting the service...
     service:
       name: nginx
       state: started
       enabled: yes



#for installing multiple package

--- 
- name: Installing Multiple Package
  hosts: Linux:Centos:Backend
  become: yes

  vars: 
   packages:
     - wget
     - curl
     - git
     - vim
  
  tasks: 

    - name: Installing Package 
      yum: 
        name: "{{packages}}"
        state: present 




---
- name: Installing Package 
  hosts: Backend:linux:centos
  become: yes
  
  vars: 
    packages:
      - git
      - vim
      - git
      - curl
      - wget 
 
 tasks:
