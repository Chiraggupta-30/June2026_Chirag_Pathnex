## 🔹 Jenkins Pipeline — Parameterized

pipeline {
 agent any 

parameters {
  string(name: 'ENVIRONMENT', defaultValue: 'dev', description: 'Type the Environemnt Name')
 }

environment {
  Company_name = 'american_express' 
 }

stages {
  
  stage('Checkout') {
     steps {
             echo "Checking out code for ${params.ENVIRONMENT} "
         }
      }

   stage('Build') {
       steps {    
                echo "Bulding the application in ${params.ENVIRONMENT}  by ${Company_name}"     # in this grovvy sytax is being passed 
              sh 'echo "Buidling the application in $ENVIRONMENT by $Company_name"'             # in this shell command is being passed
          }
        }
      }
   }

