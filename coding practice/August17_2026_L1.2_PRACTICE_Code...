#Ansible

--- 
- name: Install and enable nginx
  hosts: Ubuntu 
  become: yes 
 
  tasks: 
   - name: Installing nginx....
     yum: 
      name: nginx
      state: present
  
  - name: Enablinig the service
    service:
     name: nginx
     state: started 
     enabled: true 

