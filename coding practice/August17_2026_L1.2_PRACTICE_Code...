---------------------------------------------------------

apiVersion: apps/v1
kind:      Deployment
metadata: 
  name: front-end-deployment
spec:
  replicas: 2
  selector: 
   matchLabels: 
     app: front-end

   template: 
    metadata: 
     labels: 
       app: front-end

    spec: 
     containers: 
      - name: front-end-pod
        image: nginx:latest
        ports: 
         - containerPort: 80

